# Server Configuration
PORT=5000
NODE_ENV=development

# Database (PostgreSQL / Supabase / Neon)
DATABASE_URL="postgresql://postgres:password@localhost:5432/peopledesk?schema=public"

# Authentication
JWT_SECRET=your_super_secret_jwt_key
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Email Service (Nodemailer / SMTP)
EMAIL_FROM="PeopleDesk <noreply@peopledesk.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password

# WhatsApp Cloud API (Optional)
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERSION=v18.0
WHATSAPP_VERIFY_TOKEN=peopledesk_verify_token
WHATSAPP_NOTIFICATION_NUMBER=919000000000
